# Copia este archivo a .env.local (local) y define las mismas variables en
# Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (Vercel) y scrapers (GitHub Actions). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Fase 6). Solo servidor.
OPENAI_API_KEY=
# Con OpenRouter (clave sk-or-) se puede usar un modelo gratuito con structured outputs,
# p. ej. nvidia/nemotron-3-super-120b-a12b:free (limite: 50 peticiones gratis al dia)
OPENAI_MODELO_CHAT=gpt-4o-mini
OPENAI_MODELO_EMBEDDINGS=text-embedding-3-small

# Web Push (Fase 5). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Vercel Cron (recordatorios diarios): cadena aleatoria larga. Vercel la envia en Authorization.
CRON_SECRET=

# Scrapers (Fase 2)
SCRAPER_USER_AGENT=Eat-em/0.1 (uso personal; contacto: tu-correo@ejemplo.com)
MERCADONA_CODIGO_POSTAL=28001
