{
  "name": "eat-em",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/generar-seed.mjs",
    "db:validar": "npm run db:seed && node scripts/validar-sql.mjs",
    "scraper": "tsx --env-file-if-exists=.env.local scrapers/ejecutar.ts",
    "off": "tsx --env-file-if-exists=.env.local scrapers/off/importar.ts",
    "tiendas": "tsx --env-file-if-exists=.env.local scripts/cargar-tiendas.ts",
    "eval:ia": "tsx --env-file-if-exists=.env.local tareas/evaluar-ia.ts",
    "ia:embeddings": "tsx --env-file-if-exists=.env.local tareas/embeddings-fichas.ts",
    "test": "tsx --test lib/**/*.test.ts scrapers/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
